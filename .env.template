# EDUAI Environment Template
# Copy this file to .env and fill in your details

# 1. Groq API Key (Get from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# 2. SMTP Configuration (For Email Verification)
# If using Gmail, use an "App Password" (not your main password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# 3. Development Mode
# Set to True for teammates to see the access code on screen instantly.
DEV_MODE=False
